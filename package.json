{
  "name": "sakemaru-local-printer",
  "version": "1.0.0",
  "description": "酒まる専用のローカル印刷エージェント",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "R-Nexus",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "auto-launch": "^5.0.6",
    "axios": "^1.6.0",
    "pdf-to-printer": "^5.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.8.0"
  },
  "build": {
    "appId": "jp.sakemaru.printer",
    "productName": "酒まる印刷",
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "logo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "logo.png"
    }
  }
}
